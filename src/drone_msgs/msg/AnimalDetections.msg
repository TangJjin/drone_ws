# Time when the perception node published this detection list.
builtin_interfaces/Time stamp

# Monotonic frame sequence generated by the industrial-camera node.
uint64 frame_seq

# Source image dimensions for all pixel coordinates in targets.
uint32 image_width
uint32 image_height

# Must equal targets.size(). An empty list is published when no valid target
# is detected in the frame.
uint32 target_count
AnimalDetection[] targets
